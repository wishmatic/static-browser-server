{
	"compilerOptions": {
		"strict": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"emitDeclarationOnly": true,
		"allowSyntheticDefaultImports": true,
		"declaration": true,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"inlineSourceMap": true,
		"useUnknownInCatchVariables": false,
		"resolveJsonModule": true,
		"target": "es2020",
		"module": "preserve",
		"lib": ["ES2020"],
		"rootDir": "./src",
		"outDir": "./out"
	},
	"exclude": ["node_modules", "out"],
	"include": ["src"]
}
